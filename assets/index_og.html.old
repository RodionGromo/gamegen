<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Генератор игр</title>
</head>
<body>
	<div class="container">
		<div class="d-flex flex-column">
			<div class="mb-2">
				<h1 class="start-50 text-center">Генератор игр 3000</h1>
			</div>
			<div class="d-flex flex-column" id="promptInputPane">
				<label for="promptInputField" class="form-label">Введите, как должна выглядеть и играться игра:</label>
				<textarea class="form-control mb-2" id="promptInputField"></textarea>
				<div class="start-0">
					<button type="button" class="btn float-end" onclick="sendPrompt();">Создать игру ➡</button>
				</div>
			</div>
			<div class="d-flex flex-column" id="gameOutputPane" hidden>
				<label id="statusText" class="w-max form-label">Ваша игра готова!</label>
				<div class='w-max mb-2'>
					<canvas class="w-max" id="gameCanvas"></canvas>
				</div>
				<div class='w-max'>
					<button type="button" class="btn float-start" onclick="editPrompt();">⬅ Изменить игру</button>
				</div>
			</div>
		</div>
	</div>
	<script src="./files/engine.js"></script>
	<script src="./files/index.js"></script>
	<link href="./bootstrap/css/bootstrap.min.css" rel="stylesheet">
	<script type="module" src="./bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
